# P2-8: пример .env (скопируй в .env и измени значения при необходимости).
# Все переменные опциональные — без файла используются дефолты из config.py
# (продакшен-URL-ы). При наличии python-dotenv (см. requirements.txt) .env
# подгружается автоматически при импорте config.

# Devin
QQQ_DEVIN_LOGIN_URL=https://app.devin.ai/auth/login
QQQ_DEVIN_SIGNUP_URL=https://app.devin.ai/auth/signup
QQQ_DEVIN_APP_BASE_URL=https://app.devin.ai

# pinmx (Шаг 1: создание имейлов + Шаг 2: rainloop клиент)
QQQ_PINMX_URL=https://www.pinmx.com/ru
QQQ_MAIL_LOGIN_URL=https://mail-client.pinmx.com/

# chkr.cc (Шаг 4)
QQQ_CHKR_URL=https://chkr.cc/

# Stripe Checkout (Шаг 5)
QQQ_STRIPE_CHECKOUT_PREFIX=https://checkout.stripe.com/c/pay/
